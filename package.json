{
  "name": "text-video-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local, browser-based video editor whose edit lives in a plain JSON timeline file.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node server/dev.ts",
    "server": "node server/index.ts",
    "tl": "node cli/tl.ts",
    "schema": "node schema/export-json-schema.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p app/tsconfig.json",
    "test": "vitest run",
    "e2e": "vitest run tests/e2e.test.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "fastify": "^5.12.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
