{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "timeline.schema.json",
  "$comment": "Generated from schema/timeline.ts by `npm run schema`; do not edit by hand. Rules JSON Schema can't express (in < out, out within the source duration, sourceId matches a source, unique ids, 3-decimal rounding) are checked by the app and by `npm run tl -- validate`.",
  "type": "object",
  "properties": {
    "version": {
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        }
      ],
      "description": "Format version. Version 2 is a superset of 1; the editor and CLI write 2."
    },
    "project": {
      "description": "Project folder name, e.g. \"client-interview-oct\".",
      "type": "string"
    },
    "fps": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "resolution": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/source"
      }
    },
    "tracks": {
      "type": "object",
      "properties": {
        "main": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/mainClip"
          },
          "description": "Clips play back-to-back in array order with no gaps. Timeline positions are derived, never stored."
        },
        "voice": {
          "description": "Voiceover clips (v2), each placed at an explicit timeline time. They must not overlap.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/voiceClip"
          }
        },
        "music": {
          "description": "Music clips (Milestone 6), each placed at an explicit timeline time.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/musicClip"
          }
        },
        "mix": {
          "type": "object",
          "properties": {
            "duckMusicUnderVoice": {
              "default": 0,
              "description": "Decibels music is lowered while a voice clip plays, ramping over 0.25 s each side. 0 = off.",
              "type": "number",
              "minimum": -30,
              "maximum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "main"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "sources",
    "tracks"
  ],
  "additionalProperties": false,
  "title": "Timeline (v2)",
  "description": "One video edit. All times are seconds, rounded to 3 decimals. Clip ids must be unique across all tracks.",
  "definitions": {
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "kind": {
          "default": "media",
          "description": "\"media\" (audio and/or video) or \"image\" (a still picture: width and height, no duration, fps or audioChannels).",
          "type": "string",
          "enum": [
            "media",
            "image"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^media\\/(?!(.*\\/)?\\.\\.(\\/|$))[^\\\\]+$",
          "description": "Relative to the project folder, inside media/ (e.g. \"media/interview_take2.mp4\")."
        },
        "duration": {
          "description": "Seconds, from ffprobe.",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "width": {
          "description": "Display width in pixels, from ffprobe.",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "height": {
          "description": "Display height in pixels, from ffprobe.",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "audioChannels": {
          "description": "Channels in the first audio stream; 0 when the file has no audio.",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "path"
      ],
      "additionalProperties": false,
      "description": "A media file used by the edit. Source ids must be unique."
    },
    "mainClip": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique and stable. Keep it when the clip is edited."
        },
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "in": {
          "type": "number",
          "minimum": 0,
          "description": "Source time where the clip starts."
        },
        "out": {
          "type": "number",
          "minimum": 0,
          "description": "Source time where the clip ends."
        },
        "speed": {
          "default": 1,
          "type": "number",
          "minimum": 0.25,
          "maximum": 4
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "default": 1,
          "description": "1.0 = original level."
        },
        "muted": {
          "default": false,
          "type": "boolean"
        },
        "fit": {
          "default": "contain",
          "description": "\"contain\": the whole picture, with black bars. \"cover\": fill the frame, cropping the edges.",
          "type": "string",
          "enum": [
            "contain",
            "cover"
          ]
        },
        "zoom": {
          "description": "Image clips only: a slow zoom, scaling linearly from `from` to `to` over the clip.",
          "type": "object",
          "properties": {
            "from": {
              "type": "number",
              "minimum": 1,
              "maximum": 3
            },
            "to": {
              "type": "number",
              "minimum": 1,
              "maximum": 3
            },
            "focus": {
              "description": "The point that stays put while zooming, as fractions of the frame (default 0.5, 0.5: the centre).",
              "type": "object",
              "properties": {
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "x",
                "y"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "from",
            "to"
          ],
          "additionalProperties": false
        },
        "label": {
          "type": "string"
        },
        "note": {
          "description": "Written by a human. Don't cut or change this clip unless asked.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "sourceId",
        "in",
        "out"
      ],
      "additionalProperties": false,
      "description": "Must satisfy in < out <= source duration. sourceId must match a source. Timeline duration = (out - in) / speed. On an image source: in is 0, out is how long the image shows (0.04–3600 s), and speed is 1."
    },
    "voiceClip": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "number",
          "minimum": 0,
          "description": "Timeline time where the voiceover starts."
        },
        "in": {
          "type": "number",
          "minimum": 0
        },
        "out": {
          "type": "number",
          "minimum": 0
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "default": 1,
          "description": "1.0 = original level."
        },
        "fadeIn": {
          "type": "number",
          "minimum": 0
        },
        "fadeOut": {
          "type": "number",
          "minimum": 0
        },
        "label": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "sourceId",
        "start",
        "in",
        "out"
      ],
      "additionalProperties": false,
      "description": "Must satisfy in < out <= source duration. sourceId must match a source. Voice clips must not overlap."
    },
    "musicClip": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "number",
          "minimum": 0,
          "description": "Timeline time where the music starts."
        },
        "in": {
          "type": "number",
          "minimum": 0
        },
        "out": {
          "type": "number",
          "minimum": 0
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "default": 1,
          "description": "1.0 = original level."
        },
        "fadeIn": {
          "type": "number",
          "minimum": 0
        },
        "fadeOut": {
          "type": "number",
          "minimum": 0
        },
        "label": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "sourceId",
        "start",
        "in",
        "out"
      ],
      "additionalProperties": false,
      "description": "Must satisfy in < out <= source duration. sourceId must match a source."
    }
  }
}
