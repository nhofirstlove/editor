exports[`export command builder > builds the expected command and filter graph 1`] = `"ffmpeg -ss 0 -t 42.1 -i media/interview.mp4 -ss 2 -t 4 -i media/broll.mov -ss 50 -t 20 -i media/interview.mp4 -ss 10 -t 2 -i media/interview.mp4 -/filter_complex exports/out.filtergraph.txt -map "[outv]" -map "[outa]" -c:v libx264 -preset medium -crf 18 -pix_fmt yuv420p -c:a aac -b:a 192k -ar 48000 -movflags +faststart exports/out.mp4"`;

