exports[`export command builder > mixes the music track under the main track's sound 1`] = `
[
  "[v0][a0][v1][a1][v2][a2][v3][a3][v4][a4][v5][a5]concat=n=6:v=1:a=1[outv][dialog];",
  "[4:a:0]atrim=start=0:end=30,asetpts=PTS-STARTPTS,afade=t=in:st=0:d=1,afade=t=out:st=28:d=2,volume=0.3,aformat=sample_fmts=fltp:sample_rates=48000:channel_layouts=stereo,adelay=0:all=1[m0];",
  "[5:a:0]atrim=start=0:end=5,asetpts=PTS-STARTPTS,aformat=sample_fmts=fltp:sample_rates=48000:channel_layouts=stereo,adelay=30500:all=1[m1];",
  "[dialog][m0][m1]amix=inputs=3:duration=first:normalize=0,aformat=sample_fmts=fltp:sample_rates=48000:channel_layouts=stereo[outa]",
]
`;
